PREFIX nr:   <http://example.org/nutrireason#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX dish: <http://example.org/nutrireason/resource/dish/>
PREFIX food: <http://example.org/nutrireason/resource/food/>
PREFIX cls:  <http://example.org/nutrireason/resource/class/>
PREFIX rule: <http://example.org/nutrireason/resource/rule/>

# CQ4 - Which food groups have the most foods linked to an allergy?
# Category: aggregation. COUNT DISTINCT + GROUP BY + ORDER BY.
SELECT ?groupLabel (COUNT(DISTINCT ?food) AS ?allergyLinkedFoods)
WHERE {
  ?food nr:belongsToGroup ?g ;
        nr:containsAllergen ?a .
  ?g rdfs:label ?groupLabel .
}
GROUP BY ?groupLabel
ORDER BY DESC(?allergyLinkedFoods)
LIMIT 10