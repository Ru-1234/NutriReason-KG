PREFIX nr:   <http://example.org/nutrireason#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX dish: <http://example.org/nutrireason/resource/dish/>
PREFIX food: <http://example.org/nutrireason/resource/food/>
PREFIX cls:  <http://example.org/nutrireason/resource/class/>
PREFIX rule: <http://example.org/nutrireason/resource/rule/>

# CQ1 - Which foods and dishes contain an ingredient that can trigger a nut allergy?
# Category: multi-hop + inference.  Path: Dish -> hasIngredient -> Ingredient -> containsAllergen -> Allergen
#   (subclass of NutAllergen, RC1) -> triggers -> NutAllergy (RC2, materialised by the rules script).
# Needs: rules_graphdb.ru already executed (nr:triggers is inferred).
SELECT DISTINCT ?itemLabel ?kind ?viaLabel ?allergenLabel ?allergenClass
WHERE {
  { ?item a nr:Dish ; nr:hasIngredient ?via .
    ?via nr:containsAllergen ?a .
    BIND("Dish (via ingredient)" AS ?kind) }
  UNION
  { ?item nr:containsAllergen ?a .
    FILTER NOT EXISTS { ?item a nr:Dish }
    BIND(?item AS ?via)
    BIND("Food (direct)" AS ?kind) }
  ?a a ?allergenClass ;
     nr:triggers nr:NutAllergy ;
     rdfs:label ?allergenLabel .
  ?allergenClass rdfs:subClassOf* nr:NutAllergen .
  ?item rdfs:label ?itemLabel .
  ?via  rdfs:label ?viaLabel .
}
ORDER BY ?kind ?itemLabel
