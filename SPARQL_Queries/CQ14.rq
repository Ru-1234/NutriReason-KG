PREFIX nr:   <http://example.org/nutrireason#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX dish: <http://example.org/nutrireason/resource/dish/>
PREFIX food: <http://example.org/nutrireason/resource/food/>
PREFIX cls:  <http://example.org/nutrireason/resource/class/>
PREFIX rule: <http://example.org/nutrireason/resource/rule/>

# CQ14 - Which guideline (WHO, ADA or NIH) supports the rule that marks a food as unsafe for a condition?
# Category: multi-hop + inference. Food -> unsafeFor -> Condition -> hasRule -> DietaryRule -> hasSource -> Guideline.
# CHANGE the items in VALUES. Only the "avoid" rules are used (the low-sugar rule is a "limit" rule).
SELECT ?foodLabel ?conditionLabel ?ruleLabel ?guidelineLabel
WHERE {
  VALUES ?food { food:chocolate_syrup food:bacon_bits_meatless dish:almond_cookies dish:baked_ziti }
  ?food rdfs:label ?foodLabel ;
        nr:unsafeFor ?cond .
  ?cond rdfs:label ?conditionLabel ;
        nr:hasRule ?rule .
  ?rule nr:ruleAction ?action ;
        rdfs:label ?ruleLabel ;
        nr:hasSource ?g .
  ?g rdfs:label ?guidelineLabel .
  FILTER(STR(?action) = "avoid")
}
ORDER BY ?foodLabel ?conditionLabel
