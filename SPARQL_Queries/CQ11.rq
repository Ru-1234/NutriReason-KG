PREFIX nr:   <http://example.org/nutrireason#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX dish: <http://example.org/nutrireason/resource/dish/>
PREFIX food: <http://example.org/nutrireason/resource/food/>
PREFIX cls:  <http://example.org/nutrireason/resource/class/>
PREFIX rule: <http://example.org/nutrireason/resource/rule/>

# CQ11 - Which allergens appear most often across all dishes?
# Category: aggregation. Dish allergens include those inherited from ingredients (RC5, materialised by the rules script).
SELECT ?allergenLabel (COUNT(DISTINCT ?dish) AS ?dishes)
WHERE {
  ?dish a nr:Dish ;
        nr:containsAllergen ?a .
  ?a rdfs:label ?allergenLabel .
}
GROUP BY ?allergenLabel
ORDER BY DESC(?dishes)
LIMIT 10