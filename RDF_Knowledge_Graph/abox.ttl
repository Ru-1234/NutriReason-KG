@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nr:Hypertension nr:hasRule rule:hypertension_sodium_avoid .

nr:LactoseIntolerance nr:hasRule rule:lactoseintolerance_allergen_avoid .

nr:NutAllergy nr:hasRule rule:nutallergy_allergen_avoid .

nr:Type2Diabetes nr:hasRule rule:type2diabetes_sugar_avoid,
        rule:type2diabetes_sugar_limit_low_sugar .

